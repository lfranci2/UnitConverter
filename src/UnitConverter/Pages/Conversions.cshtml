@page "{conversionType=milestokilometers}/{input=10}"
@model ConversionsModel

@{
}

<!DOCTYPE html>

<html>
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>

<h1>@ViewData["ConversionType"]</h1>
@if (@ViewData["ErrorMessage"] != null)
{
    <div class="text-danger">
        <p>@ViewData["ErrorMessage"]</p>
    </div>
}
else
{
    <div>
        <p>Input: @ViewData["Input"] @ViewData["InputUnit"]</p>
        <p>Output: @ViewData["Output"] @ViewData["OutputUnit"]</p>
    </div>
}
</body>
</html>
